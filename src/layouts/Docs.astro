---
// A page of Docs or Developers: the section's pages on the left, the page's
// Markdown in the middle, its headings on the right; on a phone the pages
// fold into a list above it. Previous and next at its end.
import Base from "./Base.astro";
import { SECTIONS } from "../lib/site";
const { section, pages, id, title, description, headings = [] } = Astro.props;
const s = SECTIONS[section];
const i = pages.findIndex((p) => p.id === id);
const prev = pages[i - 1], next = pages[i + 1];
const toc = headings.filter((h) => h.depth === 2);
---
<Base title={`${title} · pktito ${s.title}`} description={description} current={section}>
  <div class="wrap">
    <details class="docs-mobile">
      <summary>{s.title}: {title}</summary>
      <nav class="docs-nav" aria-label={s.title}>
        <ul>{pages.map((p) => <li><a href={`/${section}/${p.id}`} aria-current={p.id === id ? "page" : undefined}>{p.data.title}</a></li>)}</ul>
      </nav>
    </details>
    <div class="docs">
      <nav class="docs-nav" aria-label={s.title}>
        <h2>{s.title}</h2>
        <ul>{pages.map((p) => <li><a href={`/${section}/${p.id}`} aria-current={p.id === id ? "page" : undefined} title={p.data.description}>{p.data.title}</a></li>)}</ul>
      </nav>
      <main class="prose">
        <h1>{title}</h1>
        <p class="lede">{description}</p>
        <slot />
        <nav class="pager" aria-label="More in this section">
          {prev ? <a href={`/${section}/${prev.id}`}><small>Previous</small>{prev.data.title}</a> : <span />}
          {next ? <a class="next" href={`/${section}/${next.id}`}><small>Next</small>{next.data.title}</a> : <span />}
        </nav>
      </main>
      {toc.length > 1 && (
        <nav class="docs-toc" aria-label="On this page">
          <h2>On this page</h2>
          <ul>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ul>
        </nav>
      )}
    </div>
  </div>
</Base>
