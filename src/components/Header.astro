---
// The site's header: the wordmark home, the sections, GitHub as its mark,
// and Download as the one button. On a phone the links fold into a menu.
import { GITHUB } from "../lib/site";
const { current = "" } = Astro.props;
const links = [
  ["docs", "/docs", "Docs"],
  ["developers", "/developers", "Developers"],
  ["about", "/about", "About"],
];
const gh = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/></svg>`;
---
<header class="site-head">
  <div class="wrap">
    <a class="pk-wordmark" href="/" aria-label="pktito, home">pktito</a>
    <nav class="site-nav" aria-label="Site">
      {links.map(([key, href, label]) => (
        <a class="wide" href={href} aria-current={current === key ? "page" : undefined}>{label}</a>
      ))}
      <a class="gh wide" href={GITHUB} title="GitHub" aria-label="GitHub" set:html={gh} />
      <details class="nav-more">
        <summary>Menu</summary>
        <div class="nav-menu">
          {links.map(([key, href, label]) => (
            <a href={href} aria-current={current === key ? "page" : undefined}>{label}</a>
          ))}
          <a href={GITHUB}>GitHub</a>
        </div>
      </details>
      <a class="pk-btn pk-btn-primary" href="/download" aria-current={current === "download" ? "page" : undefined}>Download</a>
    </nav>
  </div>
</header>
