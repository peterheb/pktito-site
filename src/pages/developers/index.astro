---
// The section's landing page: what it is for, and its pages as tiles.
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import { SECTIONS } from "../../lib/site";
const s = SECTIONS["developers"];
const pages = (await getCollection("developers")).sort((a, b) => a.data.order - b.data.order);
---
<Base title={`${s.title} · pktito`} description={s.blurb} current="developers">
  <main class="wrap">
    <section class="page-head">
      <h1 class="display">{s.title}</h1>
      <p class="measure">{s.blurb}</p>
    </section>
    <section class="part">
      <div class="cards">
        {pages.map((p) => (
          <a class="card" href={`/developers/${p.id}`}><b>{p.data.title}</b><span>{p.data.description}</span></a>
        ))}
      </div>
    </section>
  </main>
</Base>
