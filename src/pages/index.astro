---
import Base from "../layouts/Base.astro";
import Arrow from "../components/Arrow.astro";
import { GITHUB, LIBRARY } from "../lib/site";
import { existsSync, readFileSync } from "node:fs";
// The app's standard shot on each system (pktito-app's design/README.md,
// "Imagery"), each the size its PNG says. The script after the figure gives
// a visitor their own system's: iPhone and iPad the Mac's, Android the
// Windows one, ChromeOS the Linux one, and the Mac's where a system's shots
// aren't here yet. A system's shots show up when `npm run sync` brings them.
const SYSTEMS = { mac: "on a Mac", windows: "on Windows", linux: "on Linux" };
const ABOUT = "showing the transcript of chapter 1 of Alice's Adventures in Wonderland, each sentence beside its time.";
const png = (f) => {
  const b = readFileSync(f);
  return { w: b.readUInt32BE(16), h: b.readUInt32BE(20) };
};
const shots = {};
for (const [os, on] of Object.entries(SYSTEMS)) {
  const file = (t) => `public/screenshots/${os}-${t}.png`;
  if (!existsSync(file("light")) || !existsSync(file("dark"))) continue;
  shots[os] = {
    ...png(file("light")),
    light: { src: `/screenshots/${os}-light.png`, alt: `The pktito window ${on}, ${ABOUT}` },
    dark: { src: `/screenshots/${os}-dark.png`, alt: `The pktito window ${on} in dark mode, ${ABOUT}` },
  };
}
const mac = shots.mac;
---
<Base title="pktito: speech to text on your computer" description="pktito transcribes audio and video on your computer, for macOS, Windows and Linux. Free and open source.">
  <main>
    <section class="hero2 wrap">
      <div class="hero2-text">
        <h1 class="display">Drop a file. Read it.</h1>
        <p class="lead">Speech to text on your computer, with who said what.</p>
        <p class="measure">Turn recordings into text you can read, search and save, with each speaker named. Nothing leaves your computer.</p>
        <div class="actions">
          <a class="pk-btn pk-btn-primary" href="/download">Download</a>
          <Arrow href={GITHUB}>Source on GitHub</Arrow>
        </div>
        <p class="platforms">Open source for macOS, Windows and Linux.</p>
      </div>
      <figure class="shot">
        <img class="light" width={mac.w} height={mac.h} alt={mac.light.alt} />
        <img class="dark" width={mac.w} height={mac.h} alt={mac.dark.alt} />
        <noscript><img class="light" src={mac.light.src} width={mac.w} height={mac.h} alt={mac.light.alt} /><img class="dark" src={mac.dark.src} width={mac.w} height={mac.h} alt={mac.dark.alt} /></noscript>
      </figure>
      <script is:inline define:vars={{ shots }}>
        // the visitor's system, from the platform Chromium names or the user
        // agent everyone sends; Android before Linux, whose name its agent holds
        {
          const say = ((navigator.userAgentData && navigator.userAgentData.platform) || "") + " " + navigator.userAgent;
          const os = /Android/i.test(say) ? "windows" : /iPhone|iPad|iPod|Mac/i.test(say) ? "mac" : /Win/i.test(say) ? "windows" : /Linux|X11|CrOS|Chrome OS/i.test(say) ? "linux" : "mac";
          const s = shots[os] || shots.mac;
          for (const img of document.querySelectorAll(".shot > img")) {
            const t = img.classList.contains("dark") ? s.dark : s.light;
            img.width = s.w;
            img.height = s.h;
            img.alt = t.alt;
            img.src = t.src;
          }
        }
      </script>
    </section>

    <div class="band-surface">
      <section class="sect wrap" aria-label="What it does">
        <div class="facts3">
          <div>
            <h3>Who said what</h3>
            <p>pktito tells up to eight speakers apart and names each turn. Rename them, find where one speaks, and fix a line that went to the wrong person.</p>
          </div>
          <div>
            <h3>Your files, as they are</h3>
            <p>pktito opens common formats like MP3, MP4, WAV and FLAC, and works with ffmpeg for the rest. English, or 25 European languages.</p>
          </div>
          <div>
            <h3>Save it your way</h3>
            <p>Plain text, Markdown and JSON, with times and speakers. Subtitles as SRT or WebVTT.</p>
          </div>
        </div>
      </section>
    </div>

    <section class="sect wrap" aria-labelledby="faq">
      <h2 id="faq">Questions</h2>
      <div class="faq">
        <div>
          <h3>What does it run on?</h3>
          <ul>
            <li><b>macOS</b> 12 or later, on Apple silicon</li>
            <li><b>Windows</b> 10 and 11, on x64 or Arm</li>
            <li><b>Linux</b> with glibc 2.34 or later (Ubuntu 22.04, Debian 12, Raspberry Pi OS 12), on x86-64 or Arm64</li>
          </ul>
          <p>The speech model, about 600 MB, is downloaded on first launch.</p>
        </div>
        <div>
          <h3>Do I need a GPU?</h3>
          <p>No. pktito runs on the CPU, and on selected NPUs where your computer has one: Apple's Neural Engine on a Mac, two to five times as fast as its CPU, and Qualcomm's NPU in Snapdragon X Elite and X2 Elite PCs, which leaves the CPU free. Even a Raspberry Pi 5 transcribes 14 times faster than real time.</p>
        </div>
        <div>
          <h3>How fast is it?</h3>
          <p>Faster than you can listen. A recent laptop transcribes an hour of speech in about a minute, and a Raspberry Pi 5 in about four. Telling the speakers apart takes longer. <a href="/developers/benchmarks">The benchmark</a> has the figures for each machine.</p>
        </div>
        <div>
          <h3>Is it really free?</h3>
          <p>Yes. pktito is open source under the MIT license, with no account, trial or ads, and free for commercial use. NVIDIA publishes its speech models under CC BY 4.0, which allows commercial use too.</p>
        </div>
        <div>
          <h3>Does it need the internet?</h3>
          <p>Only to download the AI speech model, once. Transcription runs fully offline.</p>
        </div>
        <div>
          <h3>Is there a command line?</h3>
          <p><code>pktito-cli</code> comes with the app and can be used in batch jobs or by agents. Its lightweight dependencies are ideal for sandboxes and constrained environments.</p>
          <pre>pktito-cli interview.mp4 --srt
pktito-cli --json -o transcripts *.m4a
pktito-cli bench talks/</pre>
        </div>
        <div>
          <h3>Can I build it into my own software?</h3>
          <p>The engine is an MIT-licensed C11 library that needs only the C library, libm and threads. It runs on anything with a C compiler. <Arrow href="/developers/library">libpktito</Arrow></p>
        </div>
      </div>
    </section>
  </main>
</Base>
